# Copiare questo file in .env e compilare i valori sul computer dell'ufficio.
# Non inserire o condividere le credenziali reali in Git.

# Server HTTP dell'applicazione
APP_HOST=0.0.0.0
APP_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Connessione MySQL con utente dedicato (non usare root nell'app)
DB_HOST=localhost
DB_USER=ricambi_app
DB_PASSWORD=""
DB_NAME=gestionale_ricambi

# Generare una stringa casuale lunga prima di usare l'autenticazione
JWT_SECRET=
JWT_DURATA=8h
# Lasciare false per HTTP in rete locale; impostare true solo dopo aver attivato HTTPS.
COOKIE_SECURE=false

# Percorso locale delle foto caricate; su Windows usare un percorso assoluto, ad esempio C:\\Ricambi\\uploads
UPLOAD_DIR=./uploads
